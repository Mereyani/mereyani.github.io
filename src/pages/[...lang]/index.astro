---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import { dicts, joinList, localeParams, localePath, type Locale } from '../../i18n';
import { getProjects } from '../../lib/projects';
import { site } from '../../data/site';

export const getStaticPaths = localeParams;

const { locale } = Astro.props as { locale: Locale };
const t = dicts[locale];
const projects = await getProjects(locale);
const sections = ['about', 'experience', 'projects', 'education', 'skills'] as const;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: dicts.ar.name,
  jobTitle: t.title,
  url: new URL(localePath(locale), site.url).href,
  email: `mailto:${site.email}`,
  sameAs: [site.github, site.linkedin, site.kaggle],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Siirt University' },
  knowsLanguage: ['ar', 'tr', 'en'],
};
---

<Layout locale={locale} jsonld={jsonld}>
  <div class="shell">
    <header class="id">
      <h1><a href={localePath(locale)}>{t.name}</a></h1>
      <p class="role">{t.title}</p>
      <p class="tagline">{t.tagline}</p>

      <nav class="toc" aria-label={t.ui.sections}>
        <ol>{sections.map((s) => <li><a href={`#${s}`}>{t.nav[s]}</a></li>)}</ol>
      </nav>

      <div class="id-foot">
        <ul class="socials">
          <li><a href={site.github} aria-label={t.ui.github}><Icon name="github" /></a></li>
          <li><a href={site.linkedin} aria-label={t.ui.linkedin}><Icon name="linkedin" /></a></li>
          <li><a href={site.kaggle} aria-label="Kaggle"><Icon name="kaggle" /></a></li>
          <li><a href={`mailto:${site.email}`} aria-label={t.ui.email}><Icon name="mail" /></a></li>
        </ul>
        <a class="cv-link" href={localePath(locale, 'cv')}>{t.cv.label}</a>
        <LangSwitch locale={locale} />
      </div>
    </header>

    <main id="content">
      <section id="about" aria-labelledby="h-about">
        <h2 id="h-about" class="sec-h">{t.nav.about}</h2>
        <div class="about">{t.about.map((p) => <p>{p}</p>)}</div>
      </section>

      <section id="experience" aria-labelledby="h-experience">
        <h2 id="h-experience" class="sec-h">{t.nav.experience}</h2>
        <ol class="rows">
          {
            t.experience.map((job) => (
              <li class="row">
                <p class="when mono">{job.period}</p>
                <div>
                  <h3>{job.role}</h3>
                  <p class="where">{job.org} · {job.where}</p>
                  <ul class="points">{job.points.map((p) => <li>{p}</li>)}</ul>
                  <ul class="tags" aria-label={t.ui.technologies}>{job.tags.map((x) => <li>{x}</li>)}</ul>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="projects" aria-labelledby="h-projects">
        <h2 id="h-projects" class="sec-h">{t.nav.projects}</h2>
        <ol class="rows linked">
          {
            projects.map((p) => (
              <li class="row">
                {p.cover && <Image class="thumb" src={p.cover} alt="" widths={[288, 576]} sizes="9rem" />}
                <div>
                  <h3>
                    <a class="stretch" href={localePath(locale, `projects/${p.slug}`)}>
                      {p.text.data.title}
                      <Icon name="arrow" />
                    </a>
                  </h3>
                  {p.year && <p class="where mono">{p.year}</p>}
                  <p class="summary">{p.text.data.summary}</p>
                  {(p.github || p.kaggle) && (
                    <p class="ext">
                      {p.github && <a href={p.github}><Icon name="github" />{t.ui.code}</a>}
                      {p.kaggle && <a href={p.kaggle}><Icon name="arrow" />{t.ui.notebook}</a>}
                    </p>
                  )}
                  <ul class="tags" aria-label={t.ui.technologies}>{p.tags.map((x) => <li>{x}</li>)}</ul>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="education" aria-labelledby="h-education">
        <h2 id="h-education" class="sec-h">{t.nav.education}</h2>
        <ol class="rows">
          {
            t.education.map((e) => (
              <li class="row">
                <p class="when mono">{e.period}</p>
                <div>
                  <h3>{e.degree}</h3>
                  <p class="where">{e.org}</p>
                  <ul class="notes">{e.notes.map((n) => <li>{n}</li>)}</ul>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="skills" aria-labelledby="h-skills">
        <h2 id="h-skills" class="sec-h">{t.nav.skills}</h2>
        <dl class="pairs">
          {
            t.skills.map((s) => (
              <div>
                <dt>{s.group}</dt>
                <dd>{joinList(locale, s.items)}</dd>
              </div>
            ))
          }
        </dl>
        <h3 class="sub-h">{t.ui.languages}</h3>
        <dl class="pairs">
          {
            t.languages.map((l) => (
              <div>
                <dt>{l.name}</dt>
                <dd>{l.level}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section id="contact" aria-labelledby="h-contact">
        <h2 id="h-contact" class="sec-h">{t.nav.contact}</h2>
        <p>{t.ui.contactBody}</p>
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
      </section>

      <footer class="foot">© {new Date().getFullYear()} {t.name}</footer>
    </main>
  </div>
</Layout>

<script>
  // Grow the nav line of the section currently in view.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const a of links) {
          if (a.hash === `#${entry.target.id}`) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        }
      }
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  document.querySelectorAll('main section[id]').forEach((s) => observer.observe(s));
</script>
