---
import { dicts, langNames, localePath, locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  path?: string;
}
const { locale, path = '' } = Astro.props;
---

<nav class="langs" aria-label={dicts[locale].ui.language}>
  <ul>
    {
      locales.map((l) => (
        <li>
          <a href={localePath(l, path)} hreflang={l} lang={l} aria-current={l === locale ? 'page' : undefined}>
            {langNames[l]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
